{
  "default": "auto",
  "order": ["claude", "agy", "codex", "gemini", "opencode", "grok"],
  "agents": {
    "claude": {
      "bin": ["claude"],
      "args": ["-p", "{{prompt}}", "--output-format", "text", "--permission-mode", "bypassPermissions", "--append-system-prompt", "{{footer}}"],
      "read_args": ["-p", "{{prompt}}", "--output-format", "text", "--permission-mode", "plan", "--append-system-prompt", "{{footer}}"],
      "model_args": ["--model", "{{model}}"]
    },
    "agy": {
      "bin": ["agy", "antigravity"],
      "args": ["-p", "{{prompt}}", "--output-format", "text", "--dangerously-skip-permissions", "--add-dir", "{{workdir}}"],
      "model_args": ["--model", "{{model}}"]
    },
    "codex": {
      "bin": ["codex"],
      "args": ["exec", "-C", "{{workdir}}", "-s", "workspace-write", "{{prompt}}"],
      "read_args": ["exec", "-C", "{{workdir}}", "-s", "read-only", "{{prompt}}"],
      "model_args": ["-m", "{{model}}"]
    },
    "gemini": {
      "bin": ["gemini"],
      "args": ["-p", "{{prompt}}", "--yolo", "--output-format", "text"],
      "model_args": ["-m", "{{model}}"]
    },
    "opencode": {
      "bin": ["opencode"],
      "args": ["run", "{{prompt}}"],
      "model_args": ["-m", "{{model}}"]
    },
    "grok": {
      "bin": ["grok"],
      "args": ["-p", "{{prompt}}", "--cwd", "{{workdir}}", "--output-format", "plain", "--always-approve", "--no-auto-update"],
      "model_args": ["-m", "{{model}}"]
    }
  },
  "roles": {
    "implement": {"models": {}},
    "review": {"agents": ["codex", "claude", "grok"], "models": {}},
    "explore": {"agents": ["claude"], "models": {}},
    "why": {"agents": ["claude", "codex", "grok"], "models": {}},
    "architect": {"agents": ["claude", "codex", "grok"], "models": {}},
    "reflect": {"agents": ["claude", "codex"], "models": {}},
    "judge": {"agents": ["claude", "codex", "grok"], "models": {}},
    "synth": {"agents": ["claude"], "models": {}}
  }
}
